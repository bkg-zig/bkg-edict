# Konfiguration für den Betrieb mit docker compose.
#
# Diese Datei ist die Vorlage. Für den Betrieb wird sie nach .env kopiert:
#
#     cp .env.example .env
#
# Alle Zugangsdaten in dieser Vorlage sind Platzhalter. Vor einem
# produktiven Einsatz sind sie zu ersetzen.

# ------------------------------------------------------------- PostgreSQL ---
# Zugangsdaten der Datenbank. Der Container postgres bringt diese Werte
# ebenfalls in seiner Umgebung, damit der Server sich mit ihnen verbindet.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=edict
POSTGRES_USER=edict
POSTGRES_PASSWORD=edict_secret_change_me

# Vollständige Verbindungsangabe. Ohne diesen Wert baut edict-core die
# Verbindung aus den POSTGRES_-Variablen zusammen. Die Schreibweise
# postgresql+asyncpg:// wird von edict-core in postgresql:// umgesetzt.
DATABASE_URL=postgres://edict:edict_secret_change_me@postgres:5432/edict

# ------------------------------------------------------------------ Redis ---
# Verbindung zum Ereignisbus. Der Datenbankindex 0 ist für Edict reserviert.
REDIS_URL=redis://redis:6379/0

# ----------------------------------------------------------------- Server ---
# Bindeadresse und Port des HTTP-Servers im Container. Der Host published
# den Port EDICT_HTTP_PORT.
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
EDICT_HTTP_PORT=8080

# Geheimnis für die Signierung interner Nachrichten. Im Betrieb nicht leer
# lassen und nicht weiterverwenden.
SECRET_KEY=change-me-in-production

# Ausführliche Fehlermeldungen. In der Produktion bleibt der Wert false.
DEBUG=false

# Allowlist der erlaubten Herkunft für CORS. Mehrere Werte stehen
# kommagetrenmt in einer Zeile. Der Wert * ist unzulässig, weil der Server
# Anmeldedaten erlaubt. Der Vorgabewert des Kerns ist http://localhost:7891.
EDICT_ALLOWED_ORIGINS=http://localhost:8080

# Token für die Admin-Routen. Der Header X-Admin-Token muss diesen Wert
# tragen. Bleibt die Variable leer, sind die Admin-Routen gesperrt.
EDICT_ADMIN_TOKEN=

# --------------------------------------------------------------- ZeptoClaw ---
# Programm, mit dem der Worker die Agenten aufruft. ZeptoClaw gehört nicht
# zum Image und muss auf dem Host oder im Netz verfügbar sein.
ZEPTOCLAW_BIN=zeptoclaw

# Gesundheitsprüfung des Gateways. Der Worker bricht den Start ab, wenn die
# Adresse nicht erreichbar ist.
ZEPTOCLAW_HEALTH_URL=http://127.0.0.1:9090/health

# Arbeitsverzeichnis der ZeptoClaw-Sitzungen. Ohne Wert verwendet das
# Gateway sein eigenes Standardverzeichnis.
ZEPTOCLAW_PROJECT_DIR=

# ------------------------------------------------------------- Aufgabenlauf ---
# Verzeichnis des dateibasierten Gedächtnisses. Im Container liegt es unter
# /app/data und wird aus dem Verzeichnis data des Projekts eingebunden.
LEGACY_DATA_DIR=/app/data

# Datei mit Aufgaben im Format des Altbestands.
LEGACY_TASKS_FILE=/app/data/tasks_source.json

# Sekunden ohne Änderung, nach denen eine Aufgabe als festgefahren gilt.
STALL_THRESHOLD_SEC=180

# Zahl der erneuten Zustellversuche für ein Ereignis aus der Outbox.
MAX_DISPATCH_RETRY=3

# Sekunden bis zum Abbruch eines Dispatchs an das Gateway.
EDICT_DISPATCH_TIMEOUT_SEC=300

# Zahl der Dispatchs, die der Worker gleichzeitig ausführen darf.
EDICT_MAX_CONCURRENT_DISPATCH=3

# --------------------------------------------------------------- Kommando ---
# Basisadresse der HTTP-Schnittstelle für das Binary edict. Das Binary liest
# diese Variable selbst, edict-core kennt sie nicht.
EDICT_API_URL=http://localhost:8080
